cabal-version:   3.0
name:            zentinel-agent-protocol
version:         0.2.0.0
synopsis:        Haskell SDK for Zentinel Agent Protocol v2
description:
  A Haskell SDK for implementing Zentinel agents that communicate with
  the Zentinel reverse proxy using agent protocol v2, over a Unix domain
  socket or gRPC (the proxy's @zentinel.agent.v2.AgentServiceV2@ service).
  .
  See the README for usage examples and the full protocol specification.

license:         Apache-2.0
license-file:    LICENSE
author:          Raskell
maintainer:      agents@raskell.io
copyright:       2026 Raskell
category:        Network, Security
build-type:      Simple
tested-with:     GHC == 9.8.4
extra-doc-files: CHANGELOG.md
extra-source-files: proto/agent_v2.proto

source-repository head
  type:     git
  location: https://github.com/zentinelproxy/zentinel-agent-haskell-sdk

flag grpc
  description:
    Build the gRPC transport (grapesy). It needs the C library snappy
    (libsnappy-dev on Debian/Ubuntu, snappy on Homebrew). Turn it off with
    -f-grpc for a Unix-socket-only build without that dependency.
  default:     True
  manual:      True

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wmissing-export-lists
               -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   src

  exposed-modules:
    Zentinel.Agent.Protocol
    Zentinel.Agent.Types
    Zentinel.Agent.Handler
    Zentinel.Agent.Server
    Zentinel.Agent.Health
    Zentinel.Agent.Metrics
    Zentinel.Agent.Wire
    Zentinel.Agent.Transport.UDS

  other-modules:
    Zentinel.Agent.Internal.Logging

  build-depends:
    , base                  >= 4.19 && < 5
    , aeson                 >= 2.1  && < 2.3
    , text                  >= 2.0  && < 2.2
    , bytestring            >= 0.11 && < 0.13
    , containers            >= 0.6  && < 0.8
    , unordered-containers  >= 0.2.19 && < 0.3
    , vector                >= 0.13 && < 0.14
    , async                 >= 2.2  && < 2.3
    , stm                   >= 2.5  && < 2.6
    , network               >= 3.1  && < 3.3
    , unliftio              >= 0.2.25 && < 0.3
    , time                  >= 1.12 && < 1.15
    , hashable              >= 1.4  && < 1.6
    , mtl                   >= 2.3  && < 2.4
    , co-log-core           >= 0.3  && < 0.4
    , scientific            >= 0.3  && < 0.4
    , deepseq               >= 1.4  && < 1.6
    , directory             >= 1.3  && < 1.4
    , unix                  >= 2.8  && < 2.9

  if flag(grpc)
    cpp-options:      -DZENTINEL_GRPC
    hs-source-dirs:   gen
    exposed-modules:  Zentinel.Agent.Transport.GRPC
    -- Generated from proto/agent_v2.proto by scripts/gen-proto.sh.
    other-modules:
      Proto.AgentV2
      Proto.AgentV2_Fields
    build-depends:
      , grapesy             >= 1.1  && < 1.3
      , proto-lens          >= 0.7  && < 0.8
      , proto-lens-runtime  >= 0.7  && < 0.8
      , base64-bytestring   >= 1.2  && < 1.3

  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards
    StrictData
    TypeFamilies

test-suite zentinel-agent-protocol-test
  import:           warnings
  default-language: GHC2021
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  ghc-options:      -threaded

  other-modules:
    Zentinel.Agent.TypesSpec
    Zentinel.Agent.WireSpec
    Zentinel.Agent.UDSSpec

  build-tool-depends:
    , hspec-discover:hspec-discover >= 2.10 && < 2.12

  build-depends:
    , base
    , zentinel-agent-protocol
    , aeson
    , bytestring
    , containers
    , directory
    , filepath
    , network
    , text
    , unordered-containers
    , hspec                 >= 2.10 && < 2.12
    , QuickCheck            >= 2.14 && < 2.16

  default-extensions:
    OverloadedStrings
    LambdaCase
