cabal-version:   3.0
name:            conformance-agent
version:         0.2.0.0
synopsis:        The agent the Zentinel SDK conformance harness expects
license:         Apache-2.0
build-type:      Simple

executable conformance-agent
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
    , base >= 4.19 && < 5
    , zentinel-agent-protocol
    , aeson
    , base64-bytestring >= 1.2 && < 1.3
    , bytestring
    , containers
    , mtl
    , text
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
  default-extensions:
    OverloadedStrings
